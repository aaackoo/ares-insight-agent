# Copy to .env and fill in. .env is git-ignored.

# "openai" (default) or "azure"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI (only used when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_VERSION=2024-10-21

# ARES + agent
ARES_BASE_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest
ARES_TIMEOUT_SECONDS=10
AGENT_MAX_STEPS=8
